# --- Database -----------------------------------------------------------
# Production/deployment target is PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg2://raw_user:CHANGE_ME@localhost:5432/raw_db
# Defaults to a local SQLite file so the app runs with zero setup for
# grading/demo purposes.
DATABASE_URL=sqlite:///./raw.db

# --- AI agent -------------------------------------------------------------
# Optional. If unset, the agent automatically falls back to a deterministic,
# rule-based proposer/interpreter (see backend/app/agent.py) so the whole
# pipeline -- upload, validate, profile, propose, run, interpret, rerun --
# stays fully functional without any external API access.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Upload limits ------------------------------------------------------
MAX_UPLOAD_ROWS=200000
